{
  "name": "market-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run --no-orphans --parallel dev:api dev:web",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "bun --bun vite --host 127.0.0.1",
    "build": "bun run check && bun --bun vite build",
    "start": "bun server/index.ts --production",
    "test": "bun test",
    "test:e2e": "bun --bun playwright test",
    "check": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
